PORT=3000
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=rental_motor
JWT_SECRET=supersecretjwt
TOKEN_EXPIRES=7d
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# App base URL (used to build public file URLs)
APP_BASE_URL=http://localhost:3000

# Payment settings (server defaults; can be updated via API)
PAYMENT_BANK_NAME=BCA
PAYMENT_ACCOUNT_NUMBER=1234567890
PAYMENT_ACCOUNT_NAME=PT MotorKu
# WhatsApp phone, numeric only (E.164 without +). Example: 6281234567890
PAYMENT_WHATSAPP_PHONE=6281234567890

# IMPORTANT:
# - Do NOT put login tokens here. JWT tokens are generated at login.
# - Use the admin login endpoint to fetch a token and pass it via Authorization header.
#   Example: Authorization: Bearer <token>
